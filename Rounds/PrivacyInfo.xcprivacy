<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- HealthKit (RO-14): Rounds writes finished workouts (session, rounds,
	     estimated energy, effort) to the on-device Health store and reads only the
	     latest body-mass sample to estimate energy. Nothing is transmitted, so
	     nothing is "collected" in Apple's sense — NSPrivacyCollectedDataTypes stays
	     empty. HealthKit is also not a "required reason" API, so it needs no entry
	     in NSPrivacyAccessedAPITypes below. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @AppStorage / UserDefaults: the app's own setup + preferences,
			     read and written only within the app. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
