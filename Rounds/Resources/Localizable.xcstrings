    "settings.health.syncCaption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each finished workout is saved to the Health app — the session, its rounds, an estimate of calories burned, and how hard it felt. Rounds reads only your latest body weight, to estimate those calories."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrenamiento terminado se guarda en la app Salud: la sesión, sus rounds, una estimación de las calorías quemadas y la intensidad percibida. Rounds solo lee tu peso más reciente, para estimar esas calorías."
          }
        }
      }
