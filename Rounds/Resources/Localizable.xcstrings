          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your music dips just for the moment a bell or clap sounds, then comes straight back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está activado, tu música baja solo durante el instante en que suena una campana o un aplauso, y vuelve enseguida."
          }
        }
      }
    },
